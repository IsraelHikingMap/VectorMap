{
  "version": 8,
  "name": "Mapeak Satellite",
  "metadata": {
    "owner": "Zeev Stadler",
    "copyright": "Copyright Zeev Stadler 2019-2026. All Rights Reserved."
  },
  "sources": {
    "satellite": {
      "type": "raster",
      "tiles": [
        "https://mapeak.com/api/satellite/{z}/{x}/{y}"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 19,
      "attribution": "©Mapbox ©Maxar"
    },
    "mapeak-schema": {
      "type": "vector",
      "url": "https://mapeak.com/vector/data/mapeak-schema.json",
      "tiles": ["https://mapeak.com/vector/data/mapeak-schema/{z}/{x}/{y}.mvt"],
      "maxzoom": 14,
      "attribution": "<a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "sprite": "https://mapeak.com/content/sprite/sprite",
  "glyphs": "https://mapeak.com/assets/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {"id": "satellite", "type": "raster", "source": "satellite"},
    {
      "id": "water-line-intermittent",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "waterway",
      "minzoom": 9,
      "filter": ["all", ["==", "intermittent", 1], ["!=", "class", "ditch"]],
      "paint": {
        "line-color": "#8EBDF0",
        "line-layer-opacity": 0.5,
        "line-width": {"base": 1, "stops": [[10, 1], [14, 3]]},
        "line-dasharray": [4, 1]
      }
    },
    {
      "id": "water-line",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "waterway",
      "minzoom": 9,
      "filter": ["all", ["!=", "intermittent", 1], ["!=", "class", "ditch"]],
      "paint": {
        "line-color": "#8EBDF0",
        "line-layer-opacity": 0.5,
        "line-width": {"base": 1, "stops": [[10, 1], [14, 3]]}
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all", ["in", "hike_class", "minor", "service"]],
      "paint": {
        "line-color": "white",
        "line-layer-opacity": 0.25,
        "line-width": {"base": 1.55, "stops": [[8, 0.1], [20, 40]]}
      }
    },
    {
      "id": "road_secondary_tertiary",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all", ["in", "bike_class", "secondary", "tertiary"]],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "white",
        "line-layer-opacity": 0.25,
        "line-width": {"base": 1.4, "stops": [[6, 0.5], [20, 45]]}
      }
    },
    {
      "id": "road_trunk_primary",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["all", ["in", "bike_class", "trunk", "primary"]],
      "paint": {
        "line-color": "white",
        "line-layer-opacity": 0.25,
        "line-width": {"base": 1.4, "stops": [[6, 1], [20, 50]]}
      }
    },
    {
      "id": "road_major_motorway",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "transportation",
      "minzoom": 8,
      "maxzoom": 24,
      "filter": ["all", ["==", "bike_class", "motorway"]],
      "paint": {
        "line-color": "white",
        "line-layer-opacity": 0.25,
        "line-width": {"base": 1.4, "stops": [[4, 1], [20, 55]]}
      }
    },
    {
      "id": "track_core",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all", ["in", "bike_class", "track", "unclassified"]],
      "paint": {
        "line-color": "white",
        "line-layer-opacity": 0.25,
        "line-width": {"base": 1.55, "stops": [[14, 2], [20, 15]]}
      }
    },
    {
      "id": "path",
      "type": "line",
      "source": "mapeak-schema",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "in",
          "bike_class",
          "path",
          "steps",
          "footway",
          "pedestrian",
          "cycleway"
        ],
        ["==", "$type", "LineString"]
      ],
      "paint": {
        "line-color": "white",
        "line-layer-opacity": 0.25,
        "line-width": {"base": 1.55, "stops": [[4, 0.25], [20, 20]]}
      }
    },
    {
      "id": "place-farm",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "place",
      "minzoom": 12,
      "filter": ["all", ["in", "class", "isolated_dwelling", "hamlet"]],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
        "text-opacity": 0.67,
        "text-halo-color": "rgba(0, 0, 0, 0.75)",
        "text-halo-width": 3,
        "text-halo-blur": 1.5
      }
    },
    {
      "id": "place-alpine_hut",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "poi",
      "minzoom": 11,
      "filter": ["all", ["==", "subclass", "alpine_hut"]],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
        "text-opacity": 0.67,
        "text-halo-color": "rgba(0, 0, 0, 0.75)",
        "text-halo-width": 3,
        "text-halo-blur": 1.5
      }
    },
    {
      "id": "place-village",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "place",
      "minzoom": 11,
      "filter": ["all", ["==", "class", "village"]],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
        "text-opacity": 0.67,
        "text-halo-color": "rgba(0, 0, 0, 0.75)",
        "text-halo-width": 3,
        "text-halo-blur": 1.5
      }
    },
    {
      "id": "place-suburb",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "place",
      "minzoom": 13,
      "maxzoom": 15,
      "filter": ["==", "class", "suburb"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
        "text-opacity": 0.67,
        "text-halo-color": "rgba(0, 0, 0, 0.75)",
        "text-halo-width": 3,
        "text-halo-blur": 1.5
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "place",
      "minzoom": 10,
      "maxzoom": 13,
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
        "text-opacity": 0.67,
        "text-halo-color": "rgba(0, 0, 0, 0.75)",
        "text-halo-width": 3,
        "text-halo-blur": 1.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "place",
      "minzoom": 5,
      "maxzoom": 13,
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
        "text-opacity": 0.67,
        "text-halo-color": "rgba(0, 0, 0, 0.75)",
        "text-halo-width": 3,
        "text-halo-blur": 1.5
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "mapeak-schema",
      "source-layer": "place",
      "maxzoom": 8,
      "filter": ["==", "class", "country"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:he"],
          ["get", "name:en"],
          ["get", "name"]
        ],
        "symbol-placement": "point",
        "text-font": ["Noto Sans Condensed Bold"],
        "text-size": 18,
        "text-letter-spacing": 0.2,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "white",
